---
/**
 * Iconos de línea propios (SVG inline, sin dependencias).
 * Decorativos por defecto: aria-hidden.
 */
export type IconName = 'whatsapp' | 'arrow' | 'users' | 'layers' | 'pencil' | 'chart' | 'check' | 'camera' | 'mail' | 'phone' | 'pin' | 'menu' | 'close' | 'plus' | 'alert';

interface Props {
  name: IconName;
  class?: string;
}
const { name, class: className } = Astro.props;
---

<svg
  class={className}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.7"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  {
    name === 'whatsapp' && (
      <>
        <path d="M3.5 20.5l1.3-4.2A8.5 8.5 0 1 1 8 19.4z" />
        <path d="M9 8.6c.2-.5.5-.6.8-.6h.5c.2 0 .4.1.5.4l.7 1.7c.1.2 0 .5-.1.6l-.6.7c.6 1.1 1.5 2 2.7 2.6l.7-.6c.2-.2.4-.2.6-.1l1.7.8c.2.1.3.3.3.5v.5c0 .4-.2.7-.6.9-.6.3-1.4.4-2.3.1-2.2-.8-3.9-2.4-4.8-4.6-.3-.9-.3-1.8 0-2.9z" />
      </>
    )
  }
  {name === 'arrow' && <path d="M5 12h14M13 6l6 6-6 6" />}
  {
    name === 'users' && (
      <>
        <circle cx="9" cy="8" r="3.2" />
        <path d="M3 19.5c.6-3.2 3-5 6-5s5.4 1.8 6 5" />
        <path d="M15.5 5.2a3 3 0 0 1 0 5.6M17.5 14.8c1.8.6 3 2.2 3.5 4.7" />
      </>
    )
  }
  {
    name === 'layers' && (
      <>
        <path d="M12 3.5l8.5 4.5-8.5 4.5L3.5 8z" />
        <path d="M3.5 12.2L12 16.7l8.5-4.5M3.5 16.2L12 20.7l8.5-4.5" />
      </>
    )
  }
  {
    name === 'pencil' && (
      <>
        <path d="M4 20l1-4.2L15.6 5.2a2 2 0 0 1 2.8 0l.4.4a2 2 0 0 1 0 2.8L8.2 19z" />
        <path d="M13.5 7.3l3.2 3.2M4 20h16" />
      </>
    )
  }
  {
    name === 'chart' && (
      <>
        <path d="M4 4v16h16" />
        <path d="M8 15l3.5-4 3 2.5L20 7" />
      </>
    )
  }
  {name === 'check' && <path d="M5 12.5l4.2 4.2L19 7" />}
  {
    name === 'camera' && (
      <>
        <path d="M4 8h3l1.6-2.5h6.8L17 8h3v11H4z" />
        <circle cx="12" cy="13.2" r="3.4" />
      </>
    )
  }
  {
    name === 'mail' && (
      <>
        <rect x="3.5" y="5.5" width="17" height="13" rx="2" />
        <path d="M4 7l8 6 8-6" />
      </>
    )
  }
  {
    name === 'phone' && (
      <path d="M5 4h3.5l1.5 4-2 1.5a11 11 0 0 0 6.5 6.5L16 14l4 1.5V19a1.5 1.5 0 0 1-1.6 1.5C10.8 20 4 13.2 3.5 5.6A1.5 1.5 0 0 1 5 4z" />
    )
  }
  {
    name === 'pin' && (
      <>
        <path d="M12 21s-6.5-6-6.5-11a6.5 6.5 0 0 1 13 0c0 5-6.5 11-6.5 11z" />
        <circle cx="12" cy="10" r="2.3" />
      </>
    )
  }
  {name === 'menu' && <path d="M4 7h16M4 12h16M4 17h16" />}
  {name === 'close' && <path d="M6 6l12 12M18 6L6 18" />}
  {name === 'plus' && <path d="M12 5v14M5 12h14" />}
  {
    name === 'alert' && (
      <>
        <circle cx="12" cy="12" r="9" />
        <path d="M12 7.5v5.5M12 16.5v.01" />
      </>
    )
  }
</svg>
