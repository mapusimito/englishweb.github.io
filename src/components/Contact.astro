---
/**
 * Contacto (brief §13.5): panel Blush que refleja la portada. Una ruta entra
 * por arriba y termina en el waypoint junto al botón de envío: el destino de la página.
 */
import Icon from './Icon.astro';
import { withBase } from '../config/paths';
import { contact, hasWhatsapp, legal, phoneHref, whatsappUrl } from '../config/site';

/** Canal real que usará el formulario, por orden de preferencia. */
const channel = contact.formEndpoint
  ? 'endpoint'
  : hasWhatsapp
    ? 'whatsapp'
    : contact.email
      ? 'email'
      : 'none';

const formats = [
  { id: 'individual', label: 'Individual' },
  { id: 'pareja', label: 'Pareja' },
  { id: 'grupo', label: 'Grupo' },
  { id: 'nose', label: 'Aún no lo sé' },
];
---

<div class="panel-wrap contact-wrap">
  <section class="panel panel--blush contact" id="contacto" aria-labelledby="contact-title">
    <div class="container grid contact__grid">
      <div class="contact__intro">
        <h2 id="contact-title">Cuéntame qué necesitas.</h2>
        <p class="lead">
          Dime tu nivel aproximado, qué quieres conseguir y qué formato te interesa. Te respondo para
          resolver dudas y ver horarios.
        </p>
        {
          (hasWhatsapp || contact.email || phoneHref) && (
            <ul class="contact__channels" role="list">
              {hasWhatsapp && (
                <li>
                  <a href={whatsappUrl()} target="_blank" rel="noopener noreferrer">
                    Escríbeme por WhatsApp
                    <span class="visually-hidden">(se abre en una pestaña nueva)</span>
                  </a>
                </li>
              )}
              {contact.email && (
                <li>
                  <a href={`mailto:${contact.email}`}>{contact.email}</a>
                </li>
              )}
              {phoneHref && (
                <li>
                  <a href={phoneHref}>{contact.phone}</a>
                </li>
              )}
            </ul>
          )
        }
        {
          import.meta.env.DEV && !hasWhatsapp && !contact.email && !phoneHref && (
            <p class="dev-note small">
              Solo en desarrollo: añade WhatsApp o email en <code>src/config/site.ts</code>.
            </p>
          )
        }
      </div>

      <div class="contact__card">
        <form
          class="form"
          novalidate
          data-contact-form
          data-channel={channel}
          data-endpoint={contact.formEndpoint}
          data-whatsapp={contact.whatsapp}
          data-email={contact.email}
          action={contact.formEndpoint || undefined}
          method="post"
          aria-labelledby="form-title"
        >
          <h3 id="form-title" class="visually-hidden">Formulario de contacto</h3>

          <div class="form__summary" data-error-summary tabindex="-1" hidden>
            <p class="form__summary-title">
              <Icon name="alert" />
              Revisa estos campos:
            </p>
            <ul data-error-list></ul>
          </div>

          <div class="field">
            <label for="f-nombre">Nombre</label>
            <input id="f-nombre" name="nombre" type="text" autocomplete="name" required aria-describedby="f-nombre-error" />
            <p class="field__error" id="f-nombre-error" data-error-for="nombre"></p>
          </div>

          <div class="field">
            <label for="f-contacto">Email o teléfono</label>
            <input
              id="f-contacto"
              name="contacto"
              type="text"
              inputmode="email"
              autocomplete="email"
              required
              aria-describedby="f-contacto-error"
            />
            <p class="field__error" id="f-contacto-error" data-error-for="contacto"></p>
          </div>

          <fieldset class="field">
            <legend>¿Para quién son las clases?</legend>
            <div class="options">
              <label class="option"><input type="radio" name="alumno" value="Para mí" checked /> Para mí</label>
              <label class="option"><input type="radio" name="alumno" value="Para mi hijo o hija" /> Para mi hijo o hija</label>
            </div>
          </fieldset>

          <fieldset class="field">
            <legend>Formato</legend>
            <div class="options">
              {
                formats.map((format) => (
                  <label class="option">
                    <input
                      type="radio"
                      name="formato"
                      value={format.label}
                      checked={format.id === 'nose'}
                    />
                    {format.label}
                  </label>
                ))
              }
            </div>
          </fieldset>

          <div class="field">
            <label for="f-mensaje">Mensaje <span class="field__optional">(opcional)</span></label>
            <textarea id="f-mensaje" name="mensaje" rows="4"></textarea>
          </div>

          <div class="form__trap" aria-hidden="true">
            <label for="f-website">No rellenar</label>
            <input id="f-website" name="website" type="text" tabindex="-1" autocomplete="off" />
          </div>

          <div class="field field--check">
            <label class="option">
              <input id="f-privacidad" name="privacidad" type="checkbox" required aria-describedby="f-privacidad-error" />
              <span>He leído y acepto la <a href={withBase(legal.privacyUrl)}>política de privacidad</a>.</span>
            </label>
            <p class="field__error" id="f-privacidad-error" data-error-for="privacidad"></p>
          </div>

          {
            channel === 'none' && (
              <p class="form__notice small" role="note">
                Este formulario todavía no está conectado: por ahora no envía mensajes.
              </p>
            )
          }
          {
            (channel === 'whatsapp' || channel === 'email') && (
              <p class="form__notice small">
                {channel === 'whatsapp'
                  ? 'Al enviarlo se abre WhatsApp con tu mensaje ya escrito; solo tienes que confirmarlo.'
                  : 'Al enviarlo se abre tu correo con el mensaje ya escrito; solo tienes que confirmarlo.'}
              </p>
            )
          }

          <div class="form__submit-row">
            <svg class="route-svg contact__route" aria-hidden="true" focusable="false">
              <line x1="0" y1="0" x2="0" y2="1476"></line>
              <path d="M0 1476A24 24 0 0 0 24 1500"></path>
              <line x1="24" y1="1500" x2="100%" y2="1500"></line>
            </svg>
            <span class="waypoint contact__waypoint" aria-hidden="true"></span>
            <button class="btn btn--primary" type="submit" data-submit>
              <span data-submit-label>Enviar mensaje</span>
            </button>
          </div>

          <div class="form__status" data-status role="status" aria-live="polite" tabindex="-1" hidden></div>
        </form>

        <div class="form__success" data-success tabindex="-1" hidden>
          <h3>Mensaje enviado.</h3>
          <p>Gracias por escribirme. Te respondo por el medio que me has indicado.</p>
        </div>
      </div>
    </div>
  </section>
</div>

<style>
  .contact-wrap {
    margin-bottom: var(--section-space-tight);
  }
  .contact {
    position: relative;
    overflow: hidden;
  }
  .contact__grid {
    row-gap: var(--space-7);
  }
  .contact__intro {
    display: grid;
    gap: var(--space-5);
    align-content: start;
  }
  .contact__channels {
    display: grid;
    gap: var(--space-2);
    font-weight: var(--font-weight-semibold);
  }
  .dev-note {
    padding: var(--space-3) var(--space-4);
    border: var(--border-control) dashed var(--color-border-strong);
    border-radius: var(--radius-md);
  }
  .contact__card {
    --card-pad: var(--space-5);
    position: relative;
    padding: var(--card-pad);
    background: var(--color-surface);
    border-radius: var(--radius-lg);
  }
  @media (min-width: 900px) {
    .contact__intro {
      grid-column: 1 / span 5;
    }
    .contact__card {
      --card-pad: var(--space-6);
      grid-column: 6 / span 7;
    }
  }

  /* Formulario (§13.7) */
  .form {
    display: grid;
    gap: var(--space-5);
  }
  .field {
    display: grid;
    gap: var(--space-2);
    min-width: 0;
    margin: 0;
    padding: 0;
    border: 0;
  }
  label,
  legend {
    padding: 0;
    font-size: var(--font-size-small);
    font-weight: var(--font-weight-medium);
    line-height: var(--line-height-small);
  }
  legend {
    margin-bottom: var(--space-2);
  }
  .field__optional {
    font-weight: var(--font-weight-regular);
    color: var(--color-text-secondary);
  }
  input[type='text'],
  textarea {
    width: 100%;
    min-height: 48px;
    padding: var(--space-3) var(--space-4);
    border: var(--border-control) solid var(--color-border-strong);
    border-radius: var(--radius-md);
    background: var(--color-surface);
    color: var(--color-text-primary);
    font: inherit;
    font-size: 1.0625rem;
    transition: border-color var(--duration-base) var(--ease-standard);
  }
  textarea {
    resize: vertical;
    min-height: 7rem;
  }
  input[type='text']:hover,
  textarea:hover {
    border-color: var(--color-text-secondary);
  }
  input[type='text']:focus-visible,
  textarea:focus-visible {
    border-color: var(--color-brand-primary);
    border-radius: var(--radius-md);
  }
  [aria-invalid='true'] {
    border-color: var(--color-error) !important;
  }
  .field__error {
    display: flex;
    align-items: flex-start;
    gap: var(--space-2);
    font-size: var(--font-size-small);
    line-height: var(--line-height-small);
    color: var(--color-error);
  }
  .field__error:empty {
    display: none;
  }
  .field__error::before {
    content: '!';
    flex: none;
    display: inline-grid;
    place-items: center;
    width: 18px;
    height: 18px;
    margin-top: 2px;
    border-radius: var(--radius-pill);
    background: var(--color-error);
    color: var(--color-surface);
    font-size: 12px;
    font-weight: var(--font-weight-bold);
    line-height: 1;
  }

  /* Opciones: radio y checkbox de 20px con área táctil de 44px */
  .options {
    display: flex;
    flex-wrap: wrap;
    gap: 0 var(--space-5);
  }
  .option {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    min-height: 44px;
    font-size: var(--font-size-body);
    font-weight: var(--font-weight-regular);
    cursor: pointer;
  }
  .option input {
    appearance: none;
    flex: none;
    display: grid;
    place-items: center;
    width: 20px;
    height: 20px;
    margin: 0;
    border: var(--border-control) solid var(--color-border-strong);
    background: var(--color-surface);
    cursor: pointer;
  }
  .option input[type='radio'] {
    border-radius: var(--radius-pill);
  }
  .option input[type='checkbox'] {
    border-radius: 4px;
  }
  .option input:checked {
    border-color: var(--color-brand-primary);
    background: var(--color-brand-primary);
  }
  .option input[type='radio']:checked::after {
    content: '';
    width: 8px;
    height: 8px;
    border-radius: var(--radius-pill);
    background: var(--color-surface);
  }
  .option input[type='checkbox']:checked::after {
    content: '';
    width: 10px;
    height: 6px;
    margin-top: -2px;
    border-left: 2px solid var(--color-surface);
    border-bottom: 2px solid var(--color-surface);
    transform: rotate(-45deg);
  }
  .field--check .option {
    align-items: flex-start;
    font-size: var(--font-size-small);
  }
  .field--check .option input {
    margin-top: 2px;
  }

  .form__trap {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }
  .form__notice {
    color: var(--color-text-secondary);
  }
  .form__summary {
    padding: var(--space-4);
    border: var(--border-control) solid var(--color-error);
    border-radius: var(--radius-md);
    color: var(--color-error);
  }
  .form__summary:focus {
    outline: none;
  }
  .form__summary-title {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-weight: var(--font-weight-semibold);
  }
  .form__summary-title :global(svg) {
    width: 20px;
    height: 20px;
  }
  .form__summary ul {
    margin: var(--space-2) 0 0;
    padding-left: var(--space-6);
  }
  .form__summary a {
    color: var(--color-error);
  }

  .form__submit-row {
    position: relative;
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }
  .form__submit-row .btn {
    width: 100%;
  }
  .contact__route,
  .contact__waypoint {
    display: none;
  }
  /* Escritorio: la ruta baja por el hueco entre columnas y llega al botón */
  @media (min-width: 900px) {
    .form__submit-row .btn {
      width: auto;
    }
    .contact__waypoint {
      display: inline-block;
    }
    .contact__route {
      display: block;
      position: absolute;
      left: calc(-1 * (var(--card-pad) + var(--grid-gap) / 2));
      bottom: 50%;
      width: calc(var(--card-pad) + var(--grid-gap) / 2 - var(--route-stroke));
      height: 1500px;
      color: var(--color-route);
    }
  }

  .form__status {
    padding: var(--space-4);
    border-radius: var(--radius-md);
    background: var(--color-background);
    font-size: var(--font-size-small);
  }
  .form__status:focus {
    outline: none;
  }
  .form__status[data-tone='error'] {
    border: var(--border-control) solid var(--color-error);
    color: var(--color-error);
  }
  .form__status :global(strong) {
    display: block;
  }
  .form__success {
    display: grid;
    gap: var(--space-3);
    color: var(--color-success);
  }
  .form__success:focus {
    outline: none;
  }
  .form__success p {
    color: var(--color-text-primary);
  }
</style>

<script>
  import { initContactForm } from '../scripts/contact-form';
  initContactForm();
</script>
