---
/**
 * Símbolo «Route Mark» (brief §7.3): una ruta de dos escalones sobre una retícula
 * 24 × 24 que termina en un waypoint Coral. Decorativo: aria-hidden.
 */
interface Props {
  size?: number;
  class?: string;
}
const { size = 24, class: className } = Astro.props;
---

<svg
  class={className}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  aria-hidden="true"
  focusable="false"
>
  <path
    d="M4 20H8A4 4 0 0 0 12 16A4 4 0 0 1 16 12H17A3 3 0 0 0 20 9"
    stroke="currentColor"
    stroke-width="3.5"
    stroke-linecap="round"
    stroke-linejoin="round"></path>
  <circle cx="20" cy="4.5" r="2.75" style="fill: var(--color-brand-primary)"></circle>
</svg>
