---
interface Props {
  light?: boolean;
}
const { light = false } = Astro.props;
---

<span class:list={['logo', { 'logo--light': light }]}>
  <span class="logo__mark" aria-hidden="true">DG</span>
  <span class="logo__text">
    <span class="logo__name">Daniel Guanipa</span>
    <span class="logo__role">English teacher · Alicante</span>
  </span>
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    color: var(--ink);
  }
  .logo__mark {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 12px;
    background: var(--ink);
    color: var(--paper);
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 0.95rem;
    letter-spacing: -0.02em;
    position: relative;
  }
  .logo__mark::after {
    content: '';
    position: absolute;
    right: -3px;
    bottom: -3px;
    width: 11px;
    height: 11px;
    border-radius: 50%;
    background: var(--accent);
    border: 2px solid var(--paper);
  }
  .logo__text {
    display: grid;
    line-height: 1.15;
  }
  .logo__name {
    font-family: var(--font-display);
    font-weight: 650;
    font-size: 1.08rem;
    letter-spacing: -0.01em;
  }
  .logo__role {
    font-size: 0.78rem;
    color: var(--ink-soft);
  }
  .logo--light {
    color: var(--on-navy);
  }
  .logo--light .logo__mark {
    background: var(--on-navy);
    color: var(--navy);
  }
  .logo--light .logo__mark::after {
    border-color: var(--navy);
  }
  .logo--light .logo__role {
    color: var(--on-navy-soft);
  }
</style>
