---
/**
 * Wordmark «My Way to English.» en texto vivo (brief §7.1) hasta que exista el
 * vector definitivo: «My Way» y «English» en 800, «to» en 500, punto final en
 * Coral. La firma «by Daniel Guanipa» va siempre debajo y alineada a la izquierda.
 */
interface Props {
  layout?: 'horizontal' | 'stacked';
  inverse?: boolean;
  signature?: boolean;
  class?: string;
}
const { layout = 'horizontal', inverse = false, signature = false, class: className } = Astro.props;
---

<span class:list={['logo', `logo--${layout}`, { 'logo--inverse': inverse }, className]}>
  <span class="logo__wordmark" aria-hidden="true">
    <span class="logo__line">My Way</span>
    <span class="logo__line"><span class="logo__to">to</span> English<span class="logo__dot"></span></span>
  </span>
  <span class="visually-hidden">My Way to English</span>
  {
    signature && (
      <span class="logo__signature">
        <span aria-hidden="true">by Daniel Guanipa</span>
        <span class="visually-hidden">, por Daniel Guanipa</span>
      </span>
    )
  }
</span>

<style>
  .logo {
    --wm-size: 1.625rem;
    display: inline-flex;
    flex-direction: column;
    align-items: flex-start;
    color: var(--color-brand-primary);
  }
  .logo__wordmark {
    display: inline-flex;
    flex-wrap: wrap;
    column-gap: 0.25em;
    font-family: var(--font-display);
    font-size: var(--wm-size);
    font-weight: var(--font-weight-extrabold);
    font-variation-settings: 'opsz' 96;
    letter-spacing: -0.02em;
    line-height: 1;
    white-space: nowrap;
  }
  .logo--stacked .logo__wordmark {
    flex-direction: column;
    line-height: 0.95;
  }
  .logo__to {
    font-weight: var(--font-weight-medium);
  }
  /* El punto final es un círculo perfecto en Coral sobre la línea base */
  .logo__dot {
    display: inline-block;
    width: 0.17em;
    height: 0.17em;
    margin-left: 0.05em;
    border-radius: var(--radius-pill);
    background: var(--color-accent);
  }
  .logo__signature {
    margin-top: calc(var(--wm-size) * 0.32);
    font-family: var(--font-body);
    font-size: calc(var(--wm-size) * 0.3);
    font-weight: var(--font-weight-medium);
    letter-spacing: 0.01em;
    line-height: 1;
    color: var(--color-text-secondary);
  }
  .logo--inverse {
    color: var(--color-text-inverse);
  }
  .logo--inverse .logo__signature {
    color: var(--color-text-inverse-secondary);
  }
</style>
