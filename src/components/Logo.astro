---
/**
 * Isologo de My Way to English: isotipo mw2en (trazados originales de Daniel, sin
 * modificar) a la izquierda y el logotipo «My Way to English.» completo a su lado.
 * Es el mismo conjunto en cabecera, menú, pie e imagen para compartir; solo cambia
 * el tamaño (--wm-size) y la versión de color (`inverse` para fondos oscuros).
 *
 * Logotipo: «My Way» y «English» en Bricolage Grotesque 800, «to» en 500, «English» y punto
 * final en coral, como el «EN» del isotipo. La firma «by Daniel Guanipa» (opcional) va debajo, alineada a la izquierda.
 */
import { logoPaths, logoViewBox } from '../config/logo';

interface Props {
  inverse?: boolean;
  signature?: boolean;
  class?: string;
}
const { inverse = false, signature = false, class: className } = Astro.props;
---

<span class:list={['logo', { 'logo--inverse': inverse }, className]}>
  <svg class="logo__mark" viewBox={logoViewBox} aria-hidden="true" focusable="false">
    <path class="logo__mw" d={logoPaths.w}></path>
    <path class="logo__mw" d={logoPaths.m}></path>
    <path class="logo__en" d={logoPaths.en}></path>
  </svg>
  <span class="logo__text" aria-hidden="true">
    <span class="logo__wordmark">
      <span>My Way</span>{' '}
      <span><span class="logo__to">to</span> <span class="logo__en-word">English</span><span class="logo__dot"></span></span>
    </span>
    {signature && <span class="logo__signature">by Daniel Guanipa</span>}
  </span>
  <span class="visually-hidden">My Way to English{signature ? ', por Daniel Guanipa' : ''}</span>
</span>

<style>
  .logo {
    --wm-size: 1.3rem;
    display: inline-flex;
    align-items: center;
    gap: calc(var(--wm-size) * 0.5);
    color: var(--color-brand-primary);
  }
  /* El isotipo mide lo mismo que las dos líneas del logotipo */
  .logo__mark {
    flex: none;
    display: block;
    height: var(--mark-h, calc(var(--wm-size) * 2.05));
    width: auto;
    aspect-ratio: 7095.1 / 6433.9;
    overflow: visible;
  }
  .logo__mw {
    fill: var(--logo-mw, var(--color-brand-primary));
  }
  .logo__en {
    fill: var(--logo-en, var(--color-accent));
  }
  .logo__text {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }
  .logo__wordmark {
    display: flex;
    flex-direction: column;
    font-family: var(--font-display);
    font-size: var(--wm-size);
    font-weight: var(--font-weight-extrabold);
    font-variation-settings: 'opsz' 96;
    letter-spacing: -0.02em;
    line-height: 0.95;
    white-space: nowrap;
  }
  /* «English» y el punto en Coral, igual que el «EN» del isotipo y del favicon */
  .logo__en-word {
    color: var(--logo-en, var(--color-accent));
  }
  .logo__to {
    font-weight: var(--font-weight-medium);
  }
  /* El punto final es un círculo perfecto en Coral sobre la línea base */
  .logo__dot {
    display: inline-block;
    width: 0.17em;
    height: 0.17em;
    margin-left: 0.05em;
    border-radius: var(--radius-pill);
    background: var(--color-accent);
  }
  .logo__signature {
    margin-top: calc(var(--wm-size) * 0.3);
    font-family: var(--font-body);
    font-size: calc(var(--wm-size) * 0.42);
    font-weight: var(--font-weight-medium);
    letter-spacing: 0.01em;
    line-height: 1;
    color: var(--color-text-secondary);
  }
  .logo--inverse {
    --logo-mw: var(--color-text-inverse);
    --logo-en: var(--color-accent);
    color: var(--color-text-inverse);
  }
  .logo--inverse .logo__signature {
    color: var(--color-text-inverse-secondary);
  }
</style>
