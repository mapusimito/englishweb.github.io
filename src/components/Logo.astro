---
/**
 * Logotipo mw2en (trazados de Daniel, sin modificar). Es una imagen con nombre
 * accesible «My Way to English». Los colores se controlan con --logo-mw y --logo-en:
 * por defecto es el original (mw tinta, EN coral); `inverse` es para fondos oscuros.
 * La altura se fija con --logo-height.
 */
import { logoPaths, logoViewBox } from '../config/logo';

interface Props {
  inverse?: boolean;
  class?: string;
}
const { inverse = false, class: className } = Astro.props;
---

<svg
  class:list={['logo', { 'logo--inverse': inverse }, className]}
  viewBox={logoViewBox}
  role="img"
  aria-label="My Way to English"
  focusable="false"
>
  <path class="logo__mw" d={logoPaths.w}></path>
  <path class="logo__mw" d={logoPaths.m}></path>
  <path class="logo__en" d={logoPaths.en}></path>
</svg>

<style>
  .logo {
    --logo-height: 2.75rem;
    display: block;
    /* Proporción del dibujo: 7095 × 6434 */
    height: var(--logo-height);
    width: auto;
    aspect-ratio: 7095.1 / 6433.9;
    overflow: visible;
  }
  .logo__mw {
    fill: var(--logo-mw, var(--color-brand-primary));
  }
  .logo__en {
    fill: var(--logo-en, var(--color-accent));
  }
  .logo--inverse {
    --logo-mw: var(--color-text-inverse);
    --logo-en: var(--color-accent);
  }
</style>
