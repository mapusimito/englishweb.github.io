---
/** Preguntas frecuentes (brief §13.5, §14.2): bloque centrado de 8 columnas, <details> nativo. */
import Icon from './Icon.astro';
import { hasWhatsapp } from '../config/site';
import { cancellationNoticeHours, inPersonPlace, paymentMethod, showPending } from '../config/policies';
import { visibleFaqs, type FaqItem } from '../lib/content';
import { calculateQuote } from '../lib/pricing/engine';
import { formatEuros } from '../lib/pricing/format';

// Precio por persona de una pareja en cada plan fijo: lo calcula el motor de precios,
// así que nunca se desincroniza de lo que ve el cliente en el configurador.
const pairPrice = (hours: number) => formatEuros(calculateQuote(2, hours).monthlyPerStudentCents, true);

const allFaqs: FaqItem[] = [
  {
    q: '¿Cómo sé qué nivel de inglés tengo?',
    a: 'No hace falta que lo sepas antes de escribirme. Lo primero que hacemos es el diagnóstico: compruebo tu nivel con ejercicios y una conversación, y te digo por escrito desde dónde empezamos.',
  },
  {
    q: '¿Qué pasa en la primera sesión?',
    a: 'Empezamos por el diagnóstico: vemos tu nivel, hablamos de tus objetivos y de lo que más te cuesta. Con eso preparo el plan de las siguientes semanas. Esa primera sesión no tiene coste, así que puedes decidir después si quieres seguir con una mensualidad.',
  },
  {
    q: '¿Dónde son las clases presenciales?',
    a: `En ${inPersonPlace}, en tu casa o en un espacio tranquilo que acordemos. También online por videollamada.`,
  },
  {
    q: '¿En qué se diferencian individual, pareja y grupo?',
    a: 'Siguen el mismo método. En individual, toda la sesión se adapta a ti. En pareja o en grupo, de cuatro alumnos como máximo, la atención se reparte, pero ganas conversación y práctica con compañeros, y el precio por persona baja. Las tarifas de grupo se aplican cuando vienes con tus propios compañeros.',
  },
  {
    q: '¿Hay precio para parejas?',
    a: `Sí: ${pairPrice(3)}/mes por persona en el plan Esencial y ${pairPrice(5)}/mes por persona en el Intensivo.`,
  },
  {
    q: '¿Cómo se forman los grupos?',
    a: 'Vienes con tus propios compañeros: no asigno automáticamente a personas que se inscriben solas a grupos de desconocidos. Las parejas son de 2 alumnos y los grupos de 3 o 4, nunca más.',
  },
  {
    q: '¿Cómo sé si estoy avanzando?',
    a: 'Revisamos tu progreso de forma regular frente a los objetivos del diagnóstico. Si el alumno es menor, también se lo cuento a la familia.',
  },
  {
    q: '¿Qué significa que adaptas la explicación?',
    a: 'Que el objetivo de la clase no cambia, pero la forma de llegar a él sí: si una explicación no funciona, pruebo con otro ejemplo, una comparación con el español, un juego o más práctica en ese punto.',
  },
  {
    q: '¿Cómo se organiza el horario?',
    a: 'Según la disponibilidad de los dos. En pareja y en grupo el horario es común para todo el grupo.',
  },
  {
    q: '¿Cómo se paga?',
    a: `El pago es mensual, por adelantado, mediante ${paymentMethod}.`,
  },
  {
    q: '¿Qué pasa si no puedo asistir a una clase?',
    a: `Si avisas con al menos ${cancellationNoticeHours} horas de antelación, recuperamos la clase otro día de esa semana o la siguiente. Si avisas con menos tiempo, la clase se considera dada.`,
  },
  {
    q: '¿Cómo puedo pedir información?',
    a: hasWhatsapp
      ? 'Escríbeme por WhatsApp o rellena el formulario de contacto con tu nivel aproximado, tus objetivos y el formato que te interesa.'
      : 'Rellena el formulario de contacto con tu nivel aproximado, tus objetivos y el formato que te interesa.',
  },
];

// Las preguntas con datos pendientes [entre corchetes] no se publican hasta que se rellenen.
const faqs = visibleFaqs(allFaqs, showPending);
---

<section class="section faq" id="preguntas" aria-labelledby="faq-title">
  <div class="container grid">
    <div class="faq__block">
      <header class="section-head" data-reveal>
        <p class="eyebrow">Preguntas</p>
        <h2 id="faq-title">Lo que suelen preguntarme.</h2>
      </header>

      <div class="faq__list">
        {
          faqs.map((item) => (
            <details class="faq__item" name="faq">
              <summary>
                <span>{item.q}</span>
                <Icon name="plus" class="faq__icon" />
              </summary>
              <p class="faq__answer">{item.a}</p>
            </details>
          ))
        }
      </div>
    </div>
  </div>
</section>

<style>
  @media (min-width: 900px) {
    .faq__block {
      grid-column: 3 / span 8;
    }
  }
  .faq__list {
    display: grid;
    gap: var(--space-2);
  }
  .faq__item {
    background: var(--color-surface);
    border: var(--border-hairline) solid var(--color-border);
    border-radius: var(--radius-lg);
    transition: border-color var(--duration-base) var(--ease-standard);
  }
  .faq__item[open] {
    border-color: var(--color-brand-primary);
  }
  summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-5);
    min-height: 56px;
    padding: var(--space-4) var(--space-5);
    border-radius: var(--radius-lg);
    cursor: pointer;
    list-style: none;
    font-size: var(--font-size-h4);
    font-weight: var(--font-weight-semibold);
    line-height: var(--line-height-h4);
  }
  summary::-webkit-details-marker {
    display: none;
  }
  summary:hover span {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
  }
  summary :global(.faq__icon) {
    flex: none;
    width: 20px;
    height: 20px;
    color: var(--color-brand-primary);
    transition: transform var(--duration-base) var(--ease-standard);
  }
  details[open] summary :global(.faq__icon) {
    transform: rotate(45deg);
  }
  .faq__answer {
    max-width: var(--measure);
    padding: 0 var(--space-5) var(--space-5);
    color: var(--color-text-secondary);
  }
</style>
