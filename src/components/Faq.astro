---
/** Preguntas frecuentes (brief §13.5, §14.2): bloque centrado de 8 columnas, <details> nativo. */
import Icon from './Icon.astro';
import { hasWhatsapp } from '../config/site';
import { cancellationNoticeHours, inPersonPlace, paymentMethod, showPending } from '../config/policies';
import { visibleFaqs, type FaqItem } from '../lib/content';

const allFaqs: FaqItem[] = [
  {
    q: '¿Cómo sé qué nivel de inglés tengo?',
    a: 'No necesitas conocer tu nivel antes de escribirme. En la primera clase hacemos algunos ejercicios y hablamos para comprobar qué sabes, cómo utilizas el inglés y qué aspectos necesitas trabajar. Después te explico desde dónde empezaremos.',
  },
  {
    q: '¿Qué hacemos en la primera clase?',
    a: 'Hablamos de tus objetivos y de tu experiencia con el inglés, comprobamos tu nivel y vemos qué dificultades tienes. Con esa información podemos valorar cómo organizar las siguientes sesiones. La primera clase es gratis y no te compromete a contratar una mensualidad.',
  },
  {
    q: '¿Qué diferencia hay entre tus clases y una academia?',
    a: 'Una academia es un modelo pensado para atender a muchos alumnos a la vez, y eso suele dificultar que el profesor se dedique de forma individual a cada uno. Yo trabajo con grupos de hasta cuatro personas y soy siempre el mismo profesor: hago que todo el mundo participe, me aseguro de que el grupo avance a la par y evalúo de forma continua, con interacciones en vivo y pruebas, porque mi objetivo es que aprendas, no que pases el curso.',
  },
  {
    q: '¿Dónde se imparten las clases presenciales?',
    a: `Podemos organizar las clases en ${inPersonPlace}, en tu domicilio si acordamos esa opción o en otro espacio tranquilo que nos venga bien. También doy clases online por videollamada.`,
  },
  {
    q: '¿Qué diferencia hay entre las clases individuales, en pareja y en grupo?',
    a: 'El método de trabajo es el mismo, pero cambia cómo se organiza la sesión. En las clases individuales toda la atención se centra en ti. En pareja y en grupo puedes practicar con otros alumnos, escuchar distintas formas de expresarse y mantener conversaciones. Además, el precio por persona es menor.',
  },
  {
    q: '¿Puedo apuntarme a un grupo si no conozco a nadie?',
    a: 'Los grupos se forman con compañeros que vienen juntos. Si te interesa compartir clases, puedes venir con otra persona o con un grupo de amigos, familiares o compañeros que tengan objetivos compatibles.',
  },
  {
    q: '¿Hay descuentos por contratar más horas?',
    a: 'Sí. El precio por hora disminuye al contratar más horas semanales. Puedes consultar las opciones en el configurador y ver la mensualidad antes de enviar tu solicitud.',
  },
  {
    q: '¿Cómo sabré si estoy avanzando?',
    a: 'Revisamos los contenidos trabajados y comprobamos cómo los utilizas en ejercicios y actividades prácticas. Según tus objetivos, podemos prestar más atención a la conversación, la gramática, la comprensión oral o cualquier otra habilidad que necesites desarrollar.',
  },
  {
    q: '¿Qué significa que las clases son personalizadas?',
    a: 'Significa que preparo las clases teniendo en cuenta el nivel, los objetivos y las dificultades que vamos viendo. En clases individuales eso se centra por completo en ti; en pareja o en grupo busco un punto común y dedico tiempo a las dudas de cada persona. Por ejemplo, si entiendes una estructura gramatical al leerla, pero te cuesta utilizarla al hablar, podemos dedicar más tiempo a practicarla en conversaciones.',
  },
  {
    q: '¿Cómo se organizan los horarios?',
    a: 'Acordamos los horarios según la disponibilidad de ambos. En las clases en pareja o en grupo, todos los participantes deben compartir el mismo horario.',
  },
  {
    q: '¿Puedo recibir clases para preparar un examen?',
    a: 'Podemos valorar tus necesidades y organizar el trabajo según el examen que quieras preparar, tu nivel actual y el tiempo disponible. Conviene hablarlo antes para comprobar que el plan se ajusta a lo que necesitas.',
  },
  {
    q: '¿Cómo puedo pedir información?',
    a: hasWhatsapp
      ? 'Puedes escribirme por WhatsApp o utilizar el formulario de contacto. Cuéntame tu nivel aproximado, qué quieres conseguir y si te interesan las clases individuales, en pareja o en grupo. Te responderé personalmente para hablar de las opciones y los horarios.'
      : 'Puedes utilizar el formulario de contacto. Cuéntame tu nivel aproximado, qué quieres conseguir y si te interesan las clases individuales, en pareja o en grupo. Te responderé personalmente para hablar de las opciones y los horarios.',
  },
  // Estas dos se publican solo cuando se rellenan los datos pendientes [entre corchetes].
  {
    q: '¿Cómo se paga?',
    a: `El pago es mensual, por adelantado, mediante ${paymentMethod}.`,
  },
  {
    q: '¿Qué pasa si no puedo asistir a una clase?',
    a: `Si avisas con al menos ${cancellationNoticeHours} horas de antelación, recuperamos la clase otro día de esa semana o la siguiente. Si avisas con menos tiempo, la clase se considera dada.`,
  },
];

// Las preguntas con datos pendientes [entre corchetes] no se publican hasta que se rellenen.
const faqs = visibleFaqs(allFaqs, showPending);
---

<section class="section faq" id="preguntas" aria-labelledby="faq-title">
  <div class="container grid">
    <div class="faq__block">
      <header class="section-head" data-reveal>
        <p class="eyebrow">Preguntas</p>
        <h2 id="faq-title">Lo que suelen preguntarme</h2>
      </header>

      <div class="faq__list">
        {
          faqs.map((item) => (
            <details class="faq__item" name="faq">
              <summary>
                <span>{item.q}</span>
                <Icon name="plus" class="faq__icon" />
              </summary>
              <p class="faq__answer">{item.a}</p>
            </details>
          ))
        }
      </div>
    </div>
  </div>
</section>

<style>
  @media (min-width: 900px) {
    .faq__block {
      grid-column: 3 / span 8;
    }
  }
  .faq__list {
    display: grid;
    gap: var(--space-2);
  }
  .faq__item {
    background: var(--color-surface);
    border: var(--border-hairline) solid var(--color-border);
    border-radius: var(--radius-lg);
    transition: border-color var(--duration-base) var(--ease-standard);
  }
  .faq__item[open] {
    border-color: var(--color-brand-primary);
  }
  summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-5);
    min-height: 56px;
    padding: var(--space-4) var(--space-5);
    border-radius: var(--radius-lg);
    cursor: pointer;
    list-style: none;
    font-size: var(--font-size-h4);
    font-weight: var(--font-weight-semibold);
    line-height: var(--line-height-h4);
  }
  summary::-webkit-details-marker {
    display: none;
  }
  summary:hover span {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
  }
  summary :global(.faq__icon) {
    flex: none;
    width: 20px;
    height: 20px;
    color: var(--color-brand-primary);
    transition: transform var(--duration-base) var(--ease-standard);
  }
  details[open] summary :global(.faq__icon) {
    transform: rotate(45deg);
  }
  .faq__answer {
    max-width: var(--measure);
    padding: 0 var(--space-5) var(--space-5);
    color: var(--color-text-secondary);
  }
</style>
