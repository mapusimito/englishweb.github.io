---
/**
 * «Cómo son las clases» (brief §13.5): solo fotos reales. Con una foto, texto y
 * foto en dos columnas; con más, un mosaico asimétrico sobre la retícula de 12.
 */
import PhotoFrame from './PhotoFrame.astro';
import { gallery as allPhotos } from '../config/photos';

const gallery = allPhotos.filter((photo) => photo.src);
const single = gallery.length === 1;
---

{
  gallery.length > 0 && (
    <section class="section gallery" id="clases" aria-labelledby="gallery-title">
      <div class:list={['container grid', { 'gallery--single': single }]}>
        <header class="gallery__head" data-reveal>
          <p class="eyebrow">En clase</p>
          <h2 id="gallery-title">Cómo son las clases.</h2>
          <p class="lead">Fotos reales de clase: actividades, materiales y trabajo en grupo.</p>
        </header>
        {gallery.map((photo, i) => (
          <div class="gallery__item" data-reveal>
            <PhotoFrame
              photo={photo}
              ratio={single || i % 3 === 0 ? '4 / 5' : '1 / 1'}
              sizes={single ? '(min-width: 900px) 40vw, 92vw' : '(min-width: 900px) 33vw, 92vw'}
              caption={photo.caption}
            />
          </div>
        ))}
      </div>
    </section>
  )
}

<style>
  .gallery__head {
    display: grid;
    gap: var(--space-4);
    align-content: start;
  }
  @media (min-width: 600px) {
    .gallery__item {
      grid-column: span 4;
    }
  }
  @media (min-width: 900px) {
    .gallery__head {
      grid-column: 1 / span 12;
    }
    .gallery__item {
      grid-column: span 4;
    }
    .gallery--single .gallery__head {
      grid-column: 1 / span 6;
      align-self: center;
    }
    .gallery--single .gallery__item {
      grid-column: 8 / span 5;
    }
  }
</style>
