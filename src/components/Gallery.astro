---
import PhotoFrame from './PhotoFrame.astro';
import { gallery as allPhotos } from '../config/photos';

// Solo fotos reales: los huecos sin foto no se publican.
const gallery = allPhotos.filter((photo) => photo.src);
---

{
  gallery.length > 0 && (
    <section class="section gallery" id="galeria" aria-labelledby="gallery-title">
      <div class="container">
        <div class="gallery__head" data-reveal>
          <div class="section-head">
            <p class="eyebrow">En clase</p>
            <h2 id="gallery-title">Así es una clase por dentro.</h2>
            <p>Actividades, materiales y dinámicas de grupo de clases reales.</p>
          </div>
        </div>
        <ul class="gallery__grid" role="list">
          {gallery.map((photo, i) => (
            <li class="gallery__item" data-reveal style={`--reveal-delay: ${(i % 3) * 0.08}s`}>
              <PhotoFrame
                photo={photo}
                sizes={
                  i % 7 === 0 || i % 7 === 6
                    ? '(min-width: 900px) 58vw, 92vw'
                    : '(min-width: 900px) 40vw, 46vw'
                }
              />
            </li>
          ))}
        </ul>
      </div>
    </section>
  )
}

<style>
  .gallery {
    background: var(--paper-2);
  }
  .gallery .section-head {
    margin-bottom: clamp(2rem, 1.5rem + 2vw, 3rem);
  }

  /*
   * Cuadrícula editorial que se repite cada 7 fotos:
   *   [ancha 7][estrecha 5]
   *   [4][4][4]
   *   [5][ancha 7]
   * Las fotos se recortan con object-fit, así que cualquier proporción encaja.
   */
  .gallery__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    grid-auto-rows: clamp(10rem, 38vw, 16rem);
    gap: clamp(0.6rem, 0.4rem + 0.8vw, 1.1rem);
  }
  .gallery__item {
    min-width: 0;
  }
  .gallery__item :global(.photo) {
    height: 100%;
  }
  .gallery__item:nth-child(7n + 1) {
    grid-column: span 2;
  }

  @media (min-width: 900px) {
    .gallery__grid {
      grid-template-columns: repeat(12, 1fr);
      grid-auto-rows: clamp(11rem, 17vw, 14.5rem);
    }
    .gallery__item {
      grid-column: span 4;
    }
    .gallery__item:nth-child(7n + 1) {
      grid-column: span 7;
      grid-row: span 2;
    }
    .gallery__item:nth-child(7n + 2) {
      grid-column: span 5;
      grid-row: span 2;
    }
    .gallery__item:nth-child(7n + 6) {
      grid-column: span 5;
    }
    .gallery__item:nth-child(7n + 7) {
      grid-column: span 7;
    }
    /* Si la última fila queda incompleta, la última foto ocupa el resto. */
    .gallery__item:last-child:nth-child(7n + 3) {
      grid-column: span 12;
    }
    .gallery__item:last-child:nth-child(7n + 4) {
      grid-column: span 8;
    }
    .gallery__item:last-child:nth-child(7n + 6) {
      grid-column: span 12;
    }
  }
</style>
