---
import PhotoFrame from './PhotoFrame.astro';
import WhatsAppButton from './WhatsAppButton.astro';
import Icon from './Icon.astro';
import { heroPhoto } from '../config/photos';
import { site } from '../config/site';
---

<section class="hero" id="top" aria-labelledby="hero-title">
  <div class="container hero__grid">
    <div class="hero__copy">
      <p class="eyebrow">Clases de inglés en {site.city}</p>
      <h1 id="hero-title">
        Inglés con <span class="mark">estructura</span>, clases con <span class="mark">ritmo</span>.
      </h1>
      <p class="hero__lead">
        Soy Daniel Guanipa, profesor de inglés. Doy clases particulares, en pareja y en grupos
        reducidos: partimos de tu nivel, fijamos objetivos claros y practicamos para que
        <em>uses</em> el inglés, no solo para que lo estudies.
      </p>
      <div class="hero__ctas">
        <a class="btn btn--ink" href="#clases">
          Ver clases
          <Icon name="arrow" />
        </a>
        <WhatsAppButton variant="accent" />
      </div>
      <ul class="hero__meta" role="list">
        <li><Icon name="pin" /> {site.city}</li>
        <li><Icon name="users" /> Individual, en pareja o grupo reducido</li>
        <li><Icon name="layers" /> Desde nivel inicial</li>
      </ul>
    </div>

    <div class="hero__media">
      <PhotoFrame
        photo={heroPhoto}
        ratio="4 / 5"
        sizes="(min-width: 960px) 40vw, 92vw"
        priority
        class="hero__photo"
      />
      <div class="hero__card" aria-hidden="true">
        <span class="hero__card-label">Cómo trabajamos</span>
        <ol>
          <li><span>1</span> Evaluar</li>
          <li><span>2</span> Practicar</li>
          <li><span>3</span> Revisar</li>
        </ol>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    padding-block: clamp(1.5rem, 1rem + 3vw, 4.5rem) clamp(3rem, 2rem + 4vw, 6rem);
  }
  .hero__grid {
    display: grid;
    gap: clamp(2.5rem, 2rem + 3vw, 5rem);
    align-items: center;
  }
  @media (min-width: 960px) {
    .hero__grid {
      grid-template-columns: 1.15fr 0.85fr;
    }
  }

  .hero__copy {
    display: grid;
    gap: 1.5rem;
    justify-items: start;
  }
  h1 {
    font-size: var(--step-4);
    font-weight: 680;
    letter-spacing: -0.035em;
    line-height: 1.02;
    max-width: 14ch;
  }
  .mark {
    position: relative;
    white-space: nowrap;
    z-index: 0;
  }
  .mark::after {
    content: '';
    position: absolute;
    left: -0.04em;
    right: -0.04em;
    bottom: 0.06em;
    height: 0.3em;
    background: var(--accent);
    opacity: 0.38;
    border-radius: 3px;
    z-index: -1;
  }
  .hero__lead {
    max-width: 36rem;
    font-size: var(--step-1);
    line-height: 1.55;
    color: var(--ink-soft);
  }
  .hero__lead em {
    font-style: normal;
    color: var(--ink);
    font-weight: 600;
  }
  .hero__ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 0.25rem;
  }
  .hero__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.4rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--line);
    font-size: var(--step--1);
    color: var(--ink-soft);
  }
  .hero__meta li {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
  }
  .hero__meta :global(svg) {
    width: 1.1rem;
    height: 1.1rem;
    color: var(--accent-text);
  }

  .hero__media {
    position: relative;
    width: min(100%, 30rem);
    justify-self: center;
  }
  .hero__media::before {
    content: '';
    position: absolute;
    inset: 1.25rem -1.25rem -1.25rem 1.25rem;
    border-radius: var(--r-lg);
    background: var(--navy);
    z-index: -1;
  }
  .hero__media :global(.hero__photo) {
    border-radius: var(--r-lg);
  }

  .hero__card {
    position: absolute;
    left: -1.25rem;
    bottom: 2rem;
    display: grid;
    gap: 0.6rem;
    padding: 1rem 1.15rem;
    background: var(--card);
    border-radius: var(--r);
    box-shadow: var(--shadow);
  }
  .hero__card-label {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-soft);
  }
  .hero__card ol {
    display: flex;
    gap: 0.9rem;
    margin: 0;
    padding: 0;
    list-style: none;
    font-weight: 600;
    font-size: 0.92rem;
  }
  .hero__card li {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }
  .hero__card li span {
    display: grid;
    place-items: center;
    width: 1.5rem;
    height: 1.5rem;
    border-radius: 50%;
    background: var(--accent-wash);
    color: var(--accent-text);
    font-size: 0.75rem;
    font-weight: 700;
  }

  @media (max-width: 959px) {
    .hero__media {
      width: min(100% - 1.25rem, 26rem);
      justify-self: start;
    }
  }
  @media (max-width: 520px) {
    .hero__card {
      left: 0.75rem;
      bottom: 0.75rem;
    }
    .hero__card ol {
      gap: 0.6rem;
      font-size: 0.85rem;
    }
  }
</style>
