---
import PhotoFrame from './PhotoFrame.astro';
import Icon from './Icon.astro';
import { heroPhoto } from '../config/photos';
import { site } from '../config/site';
---

<div class="panel-wrap hero-wrap">
  <section class="panel panel--blush hero" id="top" aria-labelledby="hero-title">
    <div class="container grid hero__grid">
      <div class="hero__copy">
        <p class="eyebrow">Clases de inglés presenciales en {site.city} u online</p>
        <h1 id="hero-title">Clases de inglés que se adaptan a cómo aprendes.</h1>
        <p class="lead hero__lead">
          Individuales, en pareja o en grupos de hasta cuatro. Primero entiendo dónde te atascas;
          después diseño el camino.
        </p>
        <div class="hero__ctas">
          <a class="btn btn--primary" href="#contacto">Escríbeme</a>
          <a class="btn btn--secondary" href="#planes">
            Ver planes
            <Icon name="arrow" />
          </a>
        </div>
      </div>

      <!-- Composición: retícula 3 × 3 con el retrato y una ruta que termina en el waypoint -->
      <div class="hero__media">
        <div class="tiles">
          <PhotoFrame
            photo={heroPhoto}
            sizes="(min-width: 900px) 34vw, 92vw"
            priority
            class="tile tile--photo frame--turn-br"
          />
          <span class="tile tile--ink" aria-hidden="true"></span>
          <span class="tile tile--sand" aria-hidden="true"></span>
          <span class="tile tile--dots dot-grid" aria-hidden="true"></span>
          <svg class="route-svg tiles__route" viewBox="0 0 400 500" aria-hidden="true" focusable="false">
            <path d="M0 420H108A24 24 0 0 0 132 396V359A24 24 0 0 1 156 335H210" pathLength="1"></path>
            <circle class="waypoint-dot" cx="226" cy="335" r="6.5"></circle>
          </svg>
        </div>
      </div>

      <p class="hero__tagline small">
        <span class="waypoint" aria-hidden="true"></span>
        {site.tagline}
      </p>
    </div>
  </section>
</div>

<style>
  .hero-wrap {
    padding-top: var(--space-4);
  }
  .hero__grid {
    row-gap: var(--space-6);
    align-items: center;
  }
  .hero__copy {
    display: grid;
    gap: var(--space-5);
    justify-items: start;
  }
  .hero__copy h1 {
    margin-top: calc(-1 * var(--space-2));
  }
  .hero__ctas {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    width: 100%;
  }
  .hero__tagline {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    font-weight: var(--font-weight-medium);
    color: var(--color-text-secondary);
  }

  /* Móvil: retrato 4:5 a todo el ancho con su esquina de giro y un waypoint */
  .tiles {
    position: relative;
    container-type: inline-size;
  }
  .tiles :global(.tile--photo) {
    aspect-ratio: 4 / 5;
    --turn: 50cqi;
  }
  .tile--ink,
  .tile--sand,
  .tile--dots {
    display: none;
  }
  .tiles__route path {
    display: none;
  }
  .tiles__route {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  /* En móvil solo queda el waypoint, en el hueco de la esquina de giro */
  .tiles__route .waypoint-dot {
    transform: translate(150px, 140px);
  }

  @media (max-width: 599px) {
    .hero__ctas .btn {
      width: 100%;
    }
  }

  @media (min-width: 900px) {
    /* Una sola frase de marca: bajo los botones en escritorio y bajo la foto en móvil.
       Filas 1fr | auto | auto | 1fr: el texto y la frase quedan juntos y centrados. */
    .hero__grid {
      grid-template-rows: 1fr auto auto 1fr;
      row-gap: 0;
    }
    .hero__copy {
      grid-column: 1 / span 6;
      grid-row: 2;
    }
    .hero__tagline {
      grid-column: 1 / span 6;
      grid-row: 3;
      margin-top: var(--space-5);
    }
    .hero__media {
      grid-column: 7 / span 6;
      grid-row: 1 / span 4;
    }

    /* Escritorio: retícula 3 × 3 (12px de separación); el retrato ocupa 2 × 2 */
    .tiles {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      grid-template-rows: repeat(3, 1fr);
      gap: var(--space-3);
      aspect-ratio: 4 / 5;
      max-width: 34rem;
      margin-left: auto;
    }
    .tiles :global(.tile--photo) {
      grid-column: 1 / span 2;
      grid-row: 1 / span 2;
      aspect-ratio: auto;
      height: 100%;
      --turn: 33cqi;
    }
    .tile {
      border-radius: var(--radius-lg);
    }
    .tile--ink,
    .tile--sand,
    .tile--dots {
      display: block;
    }
    .tile--ink {
      grid-column: 3;
      grid-row: 1;
      background: var(--color-brand-primary);
    }
    .tile--sand {
      grid-column: 3;
      grid-row: 2;
      background: var(--color-background-alt);
    }
    .tile--dots {
      grid-column: 2;
      grid-row: 3;
      background-color: var(--color-background);
    }
    .tiles__route {
      color: var(--color-route);
    }
    .tiles__route path {
      display: inline;
      /* En unidades del viewBox (≈ 4px a tamaño completo): el trazo discontinuo
         que dibuja la ruta no funciona con vector-effect: non-scaling-stroke */
      vector-effect: none;
      stroke-width: 3;
      stroke-dasharray: 1;
      stroke-dashoffset: 0;
    }
    .tiles__route .waypoint-dot {
      transform: none;
    }
    /* La ruta se dibuja una vez al cargar (sin movimiento reducido: aparece completa) */
    :global(.js) .tiles__route path {
      animation: route-draw var(--duration-route-draw) var(--ease-standard) both;
    }
    :global(.js) .tiles__route .waypoint-dot {
      animation: waypoint-in var(--duration-base) var(--ease-standard) both;
      animation-delay: var(--duration-route-draw);
    }
  }

  @keyframes route-draw {
    from {
      stroke-dashoffset: 1;
    }
    to {
      stroke-dashoffset: 0;
    }
  }
  @keyframes waypoint-in {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }
</style>
