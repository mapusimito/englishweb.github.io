---
/**
 * Muestra una foto optimizada (AVIF/WebP, varios tamaños) o, si aún no hay
 * foto, un marcador "Foto pendiente" inconfundible. El contenedor reserva
 * siempre su espacio, así que no hay saltos de diseño al cargar.
 */
import { Picture } from 'astro:assets';
import type { Photo } from '../config/photos';
import Icon from './Icon.astro';

interface Props {
  photo: Photo;
  /** Atributo sizes para elegir la resolución adecuada. */
  sizes: string;
  /** Proporción CSS; si se omite, el tamaño lo controla el contenedor padre. */
  ratio?: string;
  priority?: boolean;
  class?: string;
}

const { photo, sizes, ratio, priority = false, class: className } = Astro.props;
const widths = [480, 768, 1080, 1440, 2000];
---

<figure
  class:list={['photo', className, { 'photo--pending': !photo.src }]}
  style={ratio ? `aspect-ratio: ${ratio}` : undefined}
>
  {
    photo.src ? (
      <Picture
        src={photo.src}
        alt={photo.alt}
        widths={widths.filter((w) => w <= photo.src!.width)}
        sizes={sizes}
        formats={['avif', 'webp']}
        loading={priority ? 'eager' : 'lazy'}
        fetchpriority={priority ? 'high' : 'auto'}
        decoding="async"
        style={photo.focus ? `object-position: ${photo.focus}` : undefined}
      />
    ) : (
      <div class="photo__placeholder" role="img" aria-label={`Foto pendiente: ${photo.slot}`}>
        <Icon name="camera" class="photo__icon" />
        <span class="photo__tag">Foto pendiente</span>
        <span class="photo__slot">{photo.slot}</span>
      </div>
    )
  }
  {photo.src && photo.caption && <figcaption>{photo.caption}</figcaption>}
</figure>

<style>
  .photo {
    position: relative;
    margin: 0;
    overflow: hidden;
    border-radius: var(--r);
    background: var(--paper-2);
    isolation: isolate;
  }
  .photo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .photo :global(picture) {
    display: contents;
  }
  figcaption {
    position: absolute;
    inset: auto 0 0 0;
    padding: 2.5rem 1rem 0.9rem;
    color: #fff;
    font-size: var(--step--1);
    background: linear-gradient(to top, rgb(15 27 51 / 0.7), transparent);
  }

  .photo__placeholder {
    position: absolute;
    inset: 0;
    display: grid;
    place-content: center;
    justify-items: center;
    gap: 0.45rem;
    padding: 1.25rem;
    text-align: center;
    color: var(--ink-soft);
    background-color: var(--paper-2);
    background-image: repeating-linear-gradient(
      -45deg,
      transparent 0 14px,
      rgb(20 33 61 / 0.035) 14px 28px
    );
    border: 1.5px dashed var(--line-strong);
    border-radius: inherit;
  }
  .photo__placeholder :global(.photo__icon) {
    width: 1.75rem;
    height: 1.75rem;
    opacity: 0.7;
  }
  .photo__tag {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--accent-text);
  }
  .photo__slot {
    max-width: 24ch;
    font-size: var(--step--1);
    line-height: 1.4;
  }
</style>
