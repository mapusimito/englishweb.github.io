---
/**
 * Foto optimizada (AVIF/WebP, varios tamaños) dentro de un marco de 20px, o un
 * marcador «Foto pendiente» si aún no hay foto. El marco reserva su espacio, así
 * que no hay saltos de diseño al cargar.
 */
import FrameContent from './FrameContent.astro';
import type { Photo } from '../config/photos';

interface Props {
  photo: Photo;
  /** Atributo sizes para elegir la resolución adecuada. */
  sizes: string;
  /** Proporción CSS; si se omite, el tamaño lo controla el contenedor padre. */
  ratio?: string;
  priority?: boolean;
  class?: string;
  /** Pie de foto visible bajo la imagen (describe la actividad, nunca nombra alumnos). */
  caption?: string;
}

const { photo, sizes, ratio, priority = false, class: className, caption } = Astro.props;
---

{
  caption ? (
    <figure class="figure">
      <div class:list={['frame', className]} style={ratio ? `aspect-ratio: ${ratio}` : undefined}>
        <FrameContent photo={photo} sizes={sizes} priority={priority} />
      </div>
      <figcaption class="caption">{caption}</figcaption>
    </figure>
  ) : (
    <div class:list={['frame', className]} style={ratio ? `aspect-ratio: ${ratio}` : undefined}>
      <FrameContent photo={photo} sizes={sizes} priority={priority} />
    </div>
  )
}

<style>
  .figure {
    display: grid;
    gap: var(--space-3);
    margin: 0;
  }
  .frame :global(picture) {
    display: contents;
  }
  .frame :global(.frame__pending) {
    position: absolute;
    inset: 0;
    display: grid;
    place-content: center;
    justify-items: center;
    gap: var(--space-2);
    padding: var(--space-5);
    text-align: center;
    color: var(--color-text-secondary);
    background: var(--color-background-alt);
    border: var(--border-control) dashed var(--color-border-strong);
    border-radius: inherit;
  }
  .frame :global(.frame__icon) {
    width: 28px;
    height: 28px;
  }
  .frame :global(.frame__tag) {
    font-size: var(--font-size-eyebrow);
    font-weight: var(--font-weight-semibold);
    letter-spacing: var(--letter-spacing-eyebrow);
    text-transform: uppercase;
  }
  .frame :global(.frame__slot) {
    max-width: 24ch;
    font-size: var(--font-size-caption);
    line-height: var(--line-height-small);
  }
</style>
