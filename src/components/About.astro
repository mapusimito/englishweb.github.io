---
/** Biografía (brief §13.5): retrato a la izquierda, texto a la derecha, en primera persona. */
import PhotoFrame from './PhotoFrame.astro';
import { bioPhoto } from '../config/photos';
import { credentials } from '../config/credentials';

const experience = [
  'Clases individuales y en grupo, presenciales y online.',
  'Alumnos de unos 10 a 30 años, sobre todo de nivel A1–A2, también en grupos numerosos.',
  'Rediseño de un sistema de evaluación y renovación de los materiales de clase.',
  'Kahoot, Lingoclip y juegos de mesa, usados para practicar.',
];
---

<section class="section about" id="sobre-mi" aria-labelledby="about-title">
  <div class="container grid about__grid">
    <div class="about__media" data-reveal>
      <PhotoFrame
        photo={bioPhoto}
        ratio="4 / 5"
        sizes="(min-width: 900px) 36vw, 92vw"
        class="frame--turn-tl about__photo"
      />
    </div>

    <div class="about__body" data-reveal>
      <h2 id="about-title">Hola, soy Daniel Guanipa.</h2>
      <div class="prose">
        <p>
          He dado clases de inglés a alumnos de unos 10 a 30 años, en clases individuales y en grupo,
          presenciales y online. Con perfiles tan distintos aprendí a fijarme primero en qué bloquea a
          cada alumno y solo después en cómo explicarlo.
        </p>
        <p>
          Cuando lo que desbloquea un concepto es explicarlo en español, lo explico en español: los
          falsos amigos, los tiempos verbales o ciertos sonidos suelen atascar justo ahí.
        </p>
      </div>

      <ul class="credentials" role="list" aria-label="Datos destacados">
        {
          credentials.map((item) => (
            <li class="credential">
              <p class="credential__value">
                <span aria-hidden={item.spoken ? 'true' : undefined}>{item.value}</span>
                {item.spoken && <span class="visually-hidden">{item.spoken}</span>}
              </p>
              <p class="credential__label">{item.label}</p>
            </li>
          ))
        }
      </ul>

      <div class="about__experience">
        <h3 class="about__label">Mi trayectoria en el aula</h3>
        <ul role="list">
          {experience.map((item) => <li>{item}</li>)}
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  .about__grid {
    align-items: center;
  }
  .about__media {
    max-width: 28rem;
  }
  .about__media :global(.about__photo) {
    --turn: 30vw;
  }
  .about__body {
    display: grid;
    gap: var(--space-6);
    justify-items: start;
  }
  .about__body .prose {
    color: var(--color-text-secondary);
  }
  .about__label {
    margin-bottom: var(--space-3);
    font-family: var(--font-body);
    font-size: var(--font-size-eyebrow);
    font-weight: var(--font-weight-semibold);
    letter-spacing: var(--letter-spacing-eyebrow);
    line-height: var(--line-height-ui);
    text-transform: uppercase;
    color: var(--color-text-secondary);
  }
  .about__experience {
    width: 100%;
    max-width: var(--measure);
    padding-top: var(--space-5);
    border-top: var(--border-hairline) solid var(--color-border);
  }
  .about__experience ul {
    display: grid;
    gap: var(--space-2);
  }
  .about__experience li {
    position: relative;
    padding-left: var(--space-5);
  }
  .about__experience li::before {
    content: '';
    position: absolute;
    left: 2px;
    top: 0.65em;
    width: 6px;
    height: 6px;
    border-radius: var(--radius-pill);
    background: var(--color-brand-primary);
  }

  /* Datos destacados: cuatro baldosas del mismo peso */
  .credentials {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-3);
    width: 100%;
  }
  .credential {
    display: grid;
    align-content: start;
    gap: var(--space-2);
    padding: var(--space-4);
    background: var(--color-surface);
    border: var(--border-hairline) solid var(--color-border);
    border-radius: var(--radius-lg);
  }
  .credential__value {
    font-family: var(--font-display);
    font-size: var(--font-size-h3);
    font-weight: var(--font-weight-bold);
    line-height: var(--line-height-h3);
    letter-spacing: var(--letter-spacing-h3);
    font-variant-numeric: lining-nums;
    color: var(--color-brand-primary);
  }
  .credential__label {
    font-size: var(--font-size-small);
    line-height: var(--line-height-small);
    color: var(--color-text-secondary);
  }
  @media (min-width: 900px) {
    .credentials {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
    .credential {
      padding: var(--space-4) var(--space-3);
    }
  }

  @media (min-width: 600px) {
    .about__media {
      grid-column: 1 / span 6;
    }
    .about__body {
      grid-column: 1 / span 8;
    }
  }
  @media (min-width: 900px) {
    .about__media {
      grid-column: 1 / span 5;
    }
    .about__body {
      grid-column: 6 / span 7;
    }
    .about__media :global(.about__photo) {
      --turn: 9rem;
    }
  }
</style>
