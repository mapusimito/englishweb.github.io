---
import PhotoFrame from './PhotoFrame.astro';
import WhatsAppButton from './WhatsAppButton.astro';
import Icon from './Icon.astro';
import { methodPhoto } from '../config/photos';
import { stages } from '../config/approach';

/** La fase que mejor resume el enfoque se destaca en el ciclo. */
const keyStage = 'Adaptar';
---

<section class="section method" id="metodo" aria-labelledby="method-title">
  <div class="container">
    <div class:list={['method__top', { 'method__top--photo': methodPhoto.src }]}>
      <div class="method__head" data-reveal>
        <p class="eyebrow">Método</p>
        <h2 id="method-title">Cuatro fases. Un ciclo continuo.</h2>
        <p>
          Una estructura clara da la dirección. La adaptación decide la mejor manera de llegar al
          objetivo.
        </p>
      </div>
      {
        methodPhoto.src && (
          <PhotoFrame
            photo={methodPhoto}
            ratio="4 / 3"
            sizes="(min-width: 900px) 34vw, 92vw"
            class="method__photo"
          />
        )
      }
    </div>

    <ol class="cycle" role="list" data-reveal>
      {
        stages.map((stage, i) => (
          <li
            class:list={['cycle__stage', { 'cycle__stage--key': stage.name === keyStage }]}
            style={`--i: ${i}`}
          >
            <span class="cycle__node" aria-hidden="true">
              0{i + 1}
            </span>
            <h3 class="cycle__name">
              <span class="visually-hidden">Fase {i + 1}: </span>
              {stage.name}
            </h3>
            <p class="cycle__lead">{stage.lead}</p>
            <ul class="cycle__points" role="list">
              {stage.points.map((point) => (
                <li>{point}</li>
              ))}
            </ul>
          </li>
        ))
      }
    </ol>
    <p class="cycle__loop">
      <span class="cycle__loop-icon" aria-hidden="true">↺</span>
      Al consolidar, vuelve a empezar el ciclo: cada revisión sirve como nuevo diagnóstico.
    </p>

    <div class="method__cta" data-reveal>
      <div>
        <h3>Encuentra la modalidad que mejor se adapta a ti.</h3>
        <p>
          Cuéntame qué necesitas mejorar en inglés y encontraremos un punto de partida para organizar
          tu aprendizaje.
        </p>
      </div>
      <div class="method__cta-actions">
        <WhatsAppButton variant="accent" />
        <a class="btn btn--ghost-light" href="#clases">
          Ver clases y precios
          <Icon name="arrow" />
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .method {
    --node: 3.25rem;
    --gap: clamp(1.5rem, 1rem + 1.5vw, 2.5rem);
    --track: rgb(255 255 255 / 0.18);
    background: var(--navy);
    color: var(--on-navy);
    position: relative;
    overflow: hidden;
  }
  .method::before {
    /* Retícula muy sutil, evoca un cuaderno */
    content: '';
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgb(255 255 255 / 0.035) 1px, transparent 1px),
      linear-gradient(90deg, rgb(255 255 255 / 0.035) 1px, transparent 1px);
    background-size: 44px 44px;
    mask-image: linear-gradient(to bottom, black, transparent 70%);
    pointer-events: none;
  }
  .method .container {
    position: relative;
  }

  .method__top {
    display: grid;
    gap: clamp(2rem, 1.5rem + 2vw, 3rem);
    margin-bottom: clamp(3rem, 2rem + 4vw, 5rem);
  }
  @media (min-width: 900px) {
    .method__top--photo {
      grid-template-columns: 1.35fr 0.9fr;
      align-items: end;
    }
  }
  .method__head {
    display: grid;
    gap: 1rem;
    max-width: 44rem;
  }
  .method__head .eyebrow {
    color: var(--accent);
  }
  .method__head h2 {
    font-size: var(--step-3);
  }
  .method__head p:last-child {
    font-size: var(--step-1);
    line-height: 1.5;
    color: var(--on-navy-soft);
  }
  .method__top :global(.method__photo) {
    border-radius: var(--r-lg);
    max-width: 30rem;
  }

  /* ---------------------------------------------------------------- */
  /* Ciclo: móvil = línea vertical; escritorio = línea horizontal      */
  /* ---------------------------------------------------------------- */
  .cycle {
    display: grid;
  }
  .cycle__stage {
    position: relative;
    display: grid;
    grid-template-columns: var(--node) 1fr;
    column-gap: 1.25rem;
    padding-bottom: 2.25rem;
  }
  .cycle__stage > :not(.cycle__node) {
    grid-column: 2;
  }
  /* Tramo de línea que une cada fase con la siguiente */
  .cycle__stage::after {
    content: '';
    position: absolute;
    left: calc(var(--node) / 2 - 1px);
    top: calc(var(--node) + 0.5rem);
    bottom: 0.5rem;
    width: 2px;
    background: var(--track);
    transform-origin: top;
    transition: transform 0.6s var(--ease) calc(var(--i) * 0.18s + 0.2s);
  }

  .cycle__node {
    grid-row: 1 / span 3;
    display: grid;
    place-items: center;
    width: var(--node);
    height: var(--node);
    border-radius: 50%;
    border: 2px solid rgb(255 255 255 / 0.35);
    background: var(--navy);
    font-family: var(--font-display);
    font-weight: 650;
    font-size: 1rem;
    letter-spacing: -0.02em;
    transition:
      background-color 0.25s var(--ease),
      border-color 0.25s var(--ease),
      color 0.25s var(--ease);
  }
  .cycle__stage--key .cycle__node,
  .cycle__stage:hover .cycle__node {
    background: var(--accent);
    border-color: var(--accent);
    color: var(--navy);
  }
  .cycle__name {
    font-size: var(--step-2);
    padding-top: 0.55rem;
  }
  .cycle__lead {
    margin-top: 0.6rem;
    font-size: var(--step-0);
    line-height: 1.5;
    color: var(--on-navy);
  }
  .cycle__points {
    display: grid;
    gap: 0.4rem;
    margin-top: 1rem;
    padding-top: 1rem;
    border-top: 1px solid rgb(255 255 255 / 0.1);
    font-size: var(--step--1);
    color: var(--on-navy-soft);
  }
  .cycle__points li {
    position: relative;
    padding-left: 1rem;
  }
  .cycle__points li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.6em;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--accent);
  }

  /* Vuelta al inicio */
  .cycle__loop {
    display: grid;
    grid-template-columns: var(--node) 1fr;
    column-gap: 1.25rem;
    align-items: center;
    font-size: var(--step--1);
    color: var(--on-navy-soft);
  }
  .cycle__loop-icon {
    display: grid;
    place-items: center;
    width: var(--node);
    height: var(--node);
    border-radius: 50%;
    border: 2px dashed rgb(255 255 255 / 0.35);
    color: var(--accent);
    font-size: 1.35rem;
    line-height: 1;
  }

  @media (min-width: 900px) {
    .cycle {
      grid-template-columns: repeat(4, 1fr);
      column-gap: var(--gap);
    }
    .cycle__stage {
      grid-template-columns: 1fr;
      align-content: start;
      padding-bottom: 0;
    }
    .cycle__stage > :not(.cycle__node) {
      grid-column: 1;
    }
    .cycle__node {
      grid-row: auto;
      margin-bottom: 1.25rem;
    }
    .cycle__name {
      padding-top: 0;
    }
    /* La línea pasa a ser horizontal, del nodo actual al siguiente */
    .cycle__stage::after {
      left: calc(var(--node) + 0.75rem);
      right: calc(-1 * var(--gap) + 0.75rem);
      top: calc(var(--node) / 2 - 1px);
      bottom: auto;
      width: auto;
      height: 2px;
      transform-origin: left;
    }

    /* Bucle de 04 a 01: un trazo discontinuo por debajo de las fases */
    .cycle__loop {
      position: relative;
      display: block;
      margin-top: 2.5rem;
      padding-top: 2.75rem;
      text-align: center;
    }
    .cycle__loop::before {
      content: '';
      position: absolute;
      top: 0;
      left: calc(var(--node) / 2);
      right: calc(25% - 0.75 * var(--gap) - var(--node) / 2);
      height: 1.6rem;
      border: 2px dashed rgb(255 255 255 / 0.28);
      border-top: 0;
      border-radius: 0 0 14px 14px;
    }
    .cycle__loop::after {
      /* Punta de flecha hacia la fase 01 */
      content: '';
      position: absolute;
      top: -0.35rem;
      left: calc(var(--node) / 2 - 5px);
      border: 6px solid transparent;
      border-bottom: 8px solid rgb(255 255 255 / 0.5);
      border-top: 0;
    }
    .cycle__loop-icon {
      display: none;
    }
  }
  /* El último tramo no conecta con nada: el bucle cierra el ciclo */
  .cycle__stage:last-child::after {
    display: none;
  }

  /* Los tramos se dibujan en orden al entrar en pantalla */
  :global(.js) .cycle .cycle__stage::after {
    transform: scale(0);
  }
  :global(.js) .cycle.is-visible .cycle__stage::after {
    transform: none;
  }

  /* CTA */
  .method__cta {
    display: grid;
    gap: 1.5rem;
    margin-top: clamp(3rem, 2rem + 4vw, 5rem);
    padding: clamp(1.5rem, 1rem + 2vw, 2.5rem);
    border-radius: var(--r-lg);
    background: var(--navy-2);
    border: 1px solid rgb(255 255 255 / 0.08);
  }
  @media (min-width: 900px) {
    .method__cta {
      grid-template-columns: 1fr auto;
      align-items: center;
      gap: 3rem;
    }
  }
  .method__cta h3 {
    font-size: var(--step-2);
    margin-bottom: 0.6rem;
  }
  .method__cta p {
    color: var(--on-navy-soft);
    max-width: 38rem;
  }
  .method__cta-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
</style>
