---
/**
 * Metodología en un panel Ink (brief §13.5): cuatro paradas sobre una ruta que
 * termina en el waypoint, con una vuelta atrás entre 02 y 03 (adaptar es volver
 * a diseñar). La ruta es decorativa (SVG aria-hidden); los números son texto.
 */
import { stages } from '../config/approach';
---

<div class="panel-wrap">
  <section class="panel panel--ink on-ink method" id="metodo" aria-labelledby="method-title">
    <div class="container">
      <header class="method__head" data-reveal>
        <p class="eyebrow">Método</p>
        <h2 id="method-title">Un método en cuatro pasos.</h2>
        <p class="lead">
          Cada semana sabes qué estamos trabajando, por qué y cómo te acerca a tu objetivo.
        </p>
      </header>

      <ol class="stages" role="list">
        {
          stages.map((stage, i) => (
            <li class="stage">
              <svg class="route-svg stage__route" aria-hidden="true" focusable="false">
                {i < stages.length - 1 ? (
                  <line class="stage__line" x1="12" y1="16" x2="100%" y2="16" />
                ) : (
                  <>
                    <line class="stage__line" x1="12" y1="16" x2="40%" y2="16" />
                    <svg x="40%" overflow="visible">
                      <circle class="waypoint-dot" cx="9" cy="16" r="6" />
                    </svg>
                  </>
                )}
                {i === 1 && (
                  <svg x="100%" overflow="visible">
                    <path class="stage__loop" d="M-10 16V40A24 24 0 0 1 -34 64H-58A24 24 0 0 1 -82 40V16" />
                  </svg>
                )}
                <circle class="stage__stop" cx="6" cy="16" r="5" />
              </svg>
              <svg class="route-svg stage__route-v" aria-hidden="true" focusable="false">
                {i < stages.length - 1 ? (
                  <line x1="16" y1="28" x2="16" y2="100%" />
                ) : (
                  <>
                    <line x1="16" y1="28" x2="16" y2="100%" />
                    <svg y="100%" overflow="visible">
                      <circle class="waypoint-dot" cx="16" cy="9" r="6" />
                    </svg>
                  </>
                )}
                {i === 1 && (
                  <svg y="100%" overflow="visible">
                    <path d="M16 -10H40A24 24 0 0 0 64 -34V-58A24 24 0 0 0 40 -82H16" />
                  </svg>
                )}
                {i > 0 && <line x1="16" y1="0" x2="16" y2="11" />}
                <circle class="stage__stop" cx="16" cy="16" r="5" />
              </svg>
              <p class="stage__number">0{i + 1}</p>
              <h3 class="stage__title">{stage.name}</h3>
              <p class="stage__text">{stage.text}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>
</div>

<style>
  .method__head {
    display: grid;
    gap: var(--space-4);
    margin-bottom: var(--space-8);
  }
  .stages {
    position: relative;
    display: grid;
  }
  .stage {
    position: relative;
    display: grid;
    align-content: start;
    gap: var(--space-2);
    padding: 0 0 var(--space-7) 56px;
  }
  /* La vuelta atrás de móvil necesita espacio bajo la fase 02 */
  .stage:nth-child(2) {
    padding-bottom: var(--space-9);
  }
  .stage:last-child {
    padding-bottom: var(--space-6);
  }
  .stage__number {
    font-family: var(--font-display);
    font-size: var(--font-size-h3);
    font-weight: var(--font-weight-bold);
    line-height: 1;
    color: var(--color-text-inverse-secondary);
  }
  .stage__title {
    color: var(--color-text-inverse);
  }
  .stage__text {
    max-width: 34ch;
    color: var(--color-text-inverse-secondary);
  }

  /* Rutas: color Paper sobre Ink, paradas huecas */
  .stage__route,
  .stage__route-v {
    position: absolute;
    color: var(--color-route-inverse);
  }
  .stage__stop {
    fill: var(--color-surface-inverse);
    stroke: var(--color-route-inverse);
    stroke-width: 2px;
  }
  /* Móvil: ruta vertical a 16px del borde izquierdo */
  .stage__route {
    display: none;
  }
  .stage__route-v {
    left: -16px;
    top: 0;
    width: 80px;
    height: 100%;
  }

  @media (min-width: 900px) {
    .stages {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      column-gap: var(--grid-gap);
    }
    .stage,
    .stage:nth-child(2),
    .stage:last-child {
      padding: 88px 0 0;
    }
    .stage__route-v {
      display: none;
    }
    /* Escritorio: la ruta corre sobre las columnas y salva el hueco entre ellas */
    .stage__route {
      display: block;
      left: 0;
      top: 0;
      width: calc(100% + var(--grid-gap));
      height: 72px;
    }
  }
</style>
