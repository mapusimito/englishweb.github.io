---
import { withBase } from '../config/paths';
import Icon from './Icon.astro';
import Logo from './Logo.astro';
import { navLinks } from '../config/nav';

interface Props {
  isHome?: boolean;
}
const { isHome = true } = Astro.props;
const prefix = isHome ? '' : withBase();
---

<header class="header" data-header>
  <div class="container header__inner">
    <a class="header__brand" href={isHome ? '#top' : withBase()} aria-label="My Way to English, inicio">
      <Logo class="header__logo" />
    </a>

    <nav class="header__nav" aria-label="Principal">
      <ul role="list">
        {
          navLinks.map((link) => (
            <li>
              <a href={`${prefix}${link.href}`} data-nav-link={link.href.slice(1)}>
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="header__actions">
      <a class="btn btn--primary btn--compact" href={`${prefix}#contacto`}>Escríbeme</a>
      <button
        class="header__toggle"
        type="button"
        aria-expanded="false"
        aria-controls="menu-movil"
        data-menu-open
      >
        <Icon name="menu" />
        <span class="visually-hidden">Menú</span>
      </button>
    </div>
  </div>

  <div class="sheet" id="menu-movil" role="dialog" aria-modal="true" aria-label="Menú" hidden data-sheet>
    <div class="container sheet__top">
      <Logo class="header__logo" />
      <button class="header__toggle" type="button" data-menu-close>
        <Icon name="close" />
        <span class="visually-hidden">Cerrar menú</span>
      </button>
    </div>
    <nav class="container" aria-label="Menú móvil">
      <ul role="list" class="sheet__links">
        {
          navLinks.map((link) => (
            <li>
              <a href={`${prefix}${link.href}`}>{link.label}</a>
            </li>
          ))
        }
      </ul>
      <a class="btn btn--primary sheet__cta" href={`${prefix}#contacto`}>Escríbeme</a>
    </nav>
  </div>
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--color-background);
    border-bottom: var(--border-hairline) solid transparent;
    transition:
      border-color var(--duration-base) var(--ease-standard),
      box-shadow var(--duration-base) var(--ease-standard);
  }
  .header.is-scrolled {
    border-bottom-color: var(--color-border);
    box-shadow: var(--shadow-sm);
  }
  .header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-5);
    height: var(--header-height-mobile);
  }
  .header__brand {
    display: inline-flex;
    text-decoration: none;
    border-radius: 4px;
  }
  /* Isologo: isotipo + logotipo completo, igual en móvil y escritorio */
  .header :global(.header__logo) {
    --wm-size: 1.15rem;
  }
  @media (max-width: 359px) {
    .header :global(.header__logo) {
      --wm-size: 0.95rem;
    }
  }

  .header__nav {
    display: none;
  }
  .header__nav ul {
    display: flex;
    gap: var(--space-6);
  }
  .header__nav a {
    position: relative;
    display: inline-block;
    padding-block: var(--space-2);
    font-size: var(--font-size-nav);
    font-weight: var(--font-weight-medium);
    line-height: var(--line-height-ui);
    color: var(--color-text-primary);
    text-decoration: none;
    white-space: nowrap;
  }
  .header__nav a:hover {
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 6px;
    text-decoration-color: var(--color-brand-primary);
  }
  /* Sección actual: color Ink + punto Coral de 6px debajo */
  .header__nav a[aria-current='true'] {
    color: var(--color-brand-primary);
  }
  .header__nav a[aria-current='true']::after {
    content: '';
    position: absolute;
    left: 50%;
    bottom: -6px;
    width: 6px;
    height: 6px;
    margin-left: -3px;
    border-radius: var(--radius-pill);
    background: var(--color-brand-primary);
  }

  .header__actions {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }
  .header__toggle {
    display: inline-grid;
    place-items: center;
    width: 44px;
    height: 44px;
    margin-right: calc(-1 * var(--space-2));
    border: 0;
    border-radius: var(--radius-md);
    background: transparent;
    color: var(--color-text-primary);
    cursor: pointer;
  }
  .header__toggle :global(svg) {
    width: 24px;
    height: 24px;
  }

  @media (min-width: 900px) {
    .header__inner {
      height: var(--header-height);
    }
    .header :global(.header__logo) {
      --wm-size: 1.4rem;
    }
    .header__nav {
      display: block;
      margin-left: auto;
    }
    .header__toggle {
      display: none;
    }
  }
  @media (min-width: 900px) and (max-width: 1099px) {
    .header__nav ul {
      gap: var(--space-5);
    }
  }

  /* Menú móvil: hoja a pantalla completa sobre Paper */
  .sheet {
    position: fixed;
    inset: 0;
    z-index: 60;
    overflow-y: auto;
    background: var(--color-background);
  }
  .sheet[hidden] {
    display: none;
  }
  .sheet__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: var(--header-height-mobile);
  }
  .sheet__links {
    margin-top: var(--space-5);
  }
  .sheet__links a {
    display: flex;
    align-items: center;
    min-height: 56px;
    border-bottom: var(--border-hairline) solid var(--color-border);
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: var(--font-weight-bold);
    color: var(--color-text-primary);
    text-decoration: none;
  }
  .sheet__cta {
    width: 100%;
    margin-top: var(--space-6);
  }
</style>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]');
  const sheet = document.querySelector<HTMLElement>('[data-sheet]');
  const openBtn = document.querySelector<HTMLButtonElement>('[data-menu-open]');
  const closeBtn = document.querySelector<HTMLButtonElement>('[data-menu-close]');

  const onScroll = () => header?.classList.toggle('is-scrolled', window.scrollY > 8);
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });

  // Menú móvil con foco atrapado y cierre con Esc
  const focusables = () =>
    [...(sheet?.querySelectorAll<HTMLElement>('a, button') ?? [])].filter((el) => !el.hasAttribute('disabled'));

  const setOpen = (open: boolean) => {
    if (!sheet || !openBtn) return;
    sheet.hidden = !open;
    openBtn.setAttribute('aria-expanded', String(open));
    document.documentElement.style.overflow = open ? 'hidden' : '';
    if (open) closeBtn?.focus();
    else openBtn.focus();
  };
  openBtn?.addEventListener('click', () => setOpen(true));
  closeBtn?.addEventListener('click', () => setOpen(false));
  sheet?.addEventListener('click', (event) => {
    const link = (event.target as HTMLElement).closest('a');
    if (link) {
      sheet.hidden = true;
      openBtn?.setAttribute('aria-expanded', 'false');
      document.documentElement.style.overflow = '';
    }
  });
  sheet?.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') setOpen(false);
    if (event.key !== 'Tab') return;
    const items = focusables();
    const first = items[0];
    const last = items[items.length - 1];
    if (event.shiftKey && document.activeElement === first) {
      event.preventDefault();
      last.focus();
    } else if (!event.shiftKey && document.activeElement === last) {
      event.preventDefault();
      first.focus();
    }
  });
  window.matchMedia('(min-width: 900px)').addEventListener('change', (e) => {
    if (e.matches && sheet && !sheet.hidden) setOpen(false);
  });

  // Sección actual en la navegación (aria-current)
  const links = [...document.querySelectorAll<HTMLAnchorElement>('[data-nav-link]')];
  const sections = links
    .map((link) => document.getElementById(link.dataset.navLink!))
    .filter((el): el is HTMLElement => Boolean(el));
  if ('IntersectionObserver' in window && sections.length) {
    const visible = new Map<string, boolean>();
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => visible.set(entry.target.id, entry.isIntersecting));
        const current = sections.find((section) => visible.get(section.id))?.id;
        links.forEach((link) => {
          if (link.dataset.navLink === current) link.setAttribute('aria-current', 'true');
          else link.removeAttribute('aria-current');
        });
      },
      { rootMargin: '-40% 0px -55% 0px' },
    );
    sections.forEach((section) => observer.observe(section));
  }
</script>
