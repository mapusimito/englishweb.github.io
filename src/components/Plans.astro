---
/**
 * Planes (brief §13.6): tres planes de igual peso visual que desembocan en un
 * configurador de cinco pantallas con presupuesto y mensaje de WhatsApp.
 * Las tarifas y los descuentos viven en src/config/pricing.ts.
 */
import Configurator from './configurator/Configurator';
import { contact, pricingTerms } from '../config/site';
---

<section class="section plans" id="planes" aria-labelledby="plans-title">
  <div class="container">
    <header class="section-head" data-reveal>
      <p class="eyebrow">Planes</p>
      <h2 id="plans-title">Diseña tu plan en cinco pasos.</h2>
      <p class="lead">
        Elige cuántas horas quieres a la semana, cómo repartirlas y con cuántas personas vienes. Verás tu
        precio exacto antes de enviar nada.
      </p>
    </header>

    <Configurator client:visible whatsapp={contact.whatsapp} pricingTerms={pricingTerms} />
    <noscript>
      <p class="plans__noscript">
        El configurador necesita JavaScript. Mientras tanto, puedes escribirme desde el formulario de
        <a href="#contacto">contacto</a>.
      </p>
    </noscript>
  </div>
</section>

<style>
  .plans {
    background: var(--color-background-alt);
  }
  .plans__noscript {
    margin-top: var(--space-4);
    color: var(--color-text-secondary);
  }
</style>
