---
/** Pie (brief §13.5): Route Ink a sangre, logotipo apilado inverso con firma y tagline. */
import { withBase } from '../config/paths';
import Logo from './Logo.astro';
import { navLinks } from '../config/nav';
import { contact, hasWhatsapp, legal, phoneHref, site, whatsappUrl } from '../config/site';

interface Props {
  isHome?: boolean;
}
const { isHome = true } = Astro.props;
const prefix = isHome ? '' : withBase();
const year = new Date().getFullYear();
---

<footer class="footer on-ink">
  <div class="container footer__grid">
    <div class="footer__brand">
      <Logo inverse signature class="footer__logo" />
      <p class="footer__claim">Clases de inglés en grupos reducidos, presenciales en Alicante u online.</p>
    </div>

    <nav aria-label="Pie de página">
      <p class="footer__label">Secciones</p>
      <ul role="list">
        {
          navLinks.map((link) => (
            <li>
              <a href={`${prefix}${link.href}`}>{link.label}</a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div>
      <p class="footer__label">Contacto</p>
      <ul role="list">
        {
          hasWhatsapp && (
            <li>
              <a href={whatsappUrl()} target="_blank" rel="noopener noreferrer">
                WhatsApp<span class="visually-hidden"> (se abre en una pestaña nueva)</span>
              </a>
            </li>
          )
        }
        {contact.email && <li><a href={`mailto:${contact.email}`}>{contact.email}</a></li>}
        {phoneHref && <li><a href={phoneHref}>{contact.phone}</a></li>}
        <li><a href={`${prefix}#contacto`}>Formulario de contacto</a></li>
      </ul>
    </div>
  </div>

  <div class="container">
    <div class="footer__bottom">
    <p>© <span data-year>{year}</span> {site.name}</p>
    <ul role="list" class="footer__legal">
      <li><a href={withBase(legal.legalNoticeUrl)}>Aviso legal</a></li>
      <li><a href={withBase(legal.privacyUrl)}>Privacidad</a></li>
    </ul>
    </div>
  </div>
</footer>

<script is:inline>
  document.querySelectorAll('[data-year]').forEach((el) => (el.textContent = new Date().getFullYear()));
</script>

<style>
  .footer__claim {
    margin-top: var(--space-4);
    max-width: 28ch;
    color: var(--color-text-inverse-secondary);
  }
  .footer {
    padding-block: var(--space-9) var(--space-6);
    background: var(--color-surface-inverse);
    color: var(--color-text-inverse-secondary);
    font-size: var(--font-size-small);
  }
  .footer__grid {
    display: grid;
    gap: var(--space-7);
  }
  @media (min-width: 900px) {
    .footer__grid {
      grid-template-columns: 6fr 3fr 3fr;
    }
  }
  .footer__brand {
    display: grid;
    gap: var(--space-5);
    align-content: start;
  }
  .footer__brand :global(.footer__logo) {
    --wm-size: 2.1rem;
  }
  .footer__label {
    margin-bottom: var(--space-4);
    font-size: var(--font-size-eyebrow);
    font-weight: var(--font-weight-semibold);
    letter-spacing: var(--letter-spacing-eyebrow);
    text-transform: uppercase;
    color: var(--color-text-inverse);
  }
  ul {
    display: grid;
    gap: var(--space-2);
  }
  a {
    color: var(--color-text-inverse);
    text-decoration: none;
  }
  a:hover {
    color: var(--color-text-inverse);
    text-decoration: underline;
    text-decoration-thickness: 2px;
  }
  .footer__bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-4);
    margin-top: var(--space-8);
    padding-top: var(--space-5);
    border-top: var(--border-hairline) solid var(--color-border-inverse);
  }
  .footer__legal {
    display: flex;
    gap: var(--space-5);
  }
</style>
