---
import '../styles/global.css';
import { site, missingConfig } from '../config/site';
import { withBase } from '../config/paths';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
  /** Rutas de navegación relativas a la home cuando la página no es la home. */
  isHome?: boolean;
  noindex?: boolean;
}

const {
  title = site.title,
  description = site.description,
  isHome = true,
  noindex = false,
} = Astro.props;

const pathname = Astro.url.pathname.replace(/\/?$/, '/');
const canonical = new URL(pathname, site.url).href;
const ogImage = new URL(withBase('og-image.png'), site.url).href;

if (import.meta.env.SSR && missingConfig.length && isHome) {
  console.warn(
    `\n[config] Datos pendientes en src/config/site.ts: ${missingConfig.join(', ')}\n`,
  );
}

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.name,
  jobTitle: site.role,
  url: site.url,
  knowsLanguage: ['es', 'en'],
  address: { '@type': 'PostalAddress', addressLocality: site.city, addressCountry: 'ES' },
};
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#f6f2ea" />
    <link rel="icon" href={withBase('favicon.svg')} type="image/svg+xml" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content={site.locale} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />

    {isHome && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Saltar al contenido</a>
    <Header isHome={isHome} />
    <main id="main">
      <slot />
    </main>
    <Footer isHome={isHome} />
    <script>
      import '../scripts/reveal';
    </script>
  </body>
</html>
