---
import '../styles/global.css';
import { site, missingConfig } from '../config/site';
import { withBase } from '../config/paths';
import interLatin from '../styles/fonts/inter-latin.woff2?url';
import bricolageLatin from '../styles/fonts/bricolage-latin.woff2?url';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
  /** Título y descripción para redes sociales (Open Graph y Twitter). */
  ogTitle?: string;
  ogDescription?: string;
  /** Rutas de navegación relativas a la home cuando la página no es la home. */
  isHome?: boolean;
  noindex?: boolean;
}

const {
  title = site.title,
  description = site.description,
  ogTitle = title === site.title ? site.ogTitle : title,
  ogDescription = description === site.description ? site.ogDescription : description,
  isHome = true,
  noindex = false,
} = Astro.props;

const pathname = Astro.url.pathname.replace(/\/?$/, '/');
const origin = Astro.site?.origin ?? site.url;
const canonical = new URL(pathname, origin).href;
const ogImage = new URL(withBase('og-image.png'), origin).href;

if (import.meta.env.SSR && missingConfig.length && isHome) {
  console.warn(
    `\n[config] Datos pendientes en src/config/site.ts: ${missingConfig.join(', ')}\n`,
  );
}

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.name,
  jobTitle: site.role,
  brand: { '@type': 'Brand', name: site.brand },
  url: new URL(withBase(), origin).href,
  knowsLanguage: ['es', 'en'],
  address: { '@type': 'PostalAddress', addressLocality: site.city, addressCountry: 'ES' },
};
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#FBF8F3" />
    <link rel="icon" href={withBase('favicon.ico') + '?v=2'} sizes="32x32" />
    <link rel="icon" href={withBase('favicon.svg') + '?v=2'} type="image/svg+xml" />
    <link rel="icon" href={withBase('favicon-32.png') + '?v=2'} type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href={withBase('apple-touch-icon.png') + '?v=2'} />
    <link rel="preload" href={interLatin} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={bricolageLatin} as="font" type="font/woff2" crossorigin />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content={site.locale} />
    <meta property="og:site_name" content={site.brand} />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={ogDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Isologo de My Way to English: el isotipo «mw» en azul sobre «EN» en coral junto al texto «My Way to English» con «English» también en coral, con «Clases de inglés presenciales en Alicante u online, by Daniel Guanipa»." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={ogTitle} />
    <meta name="twitter:description" content={ogDescription} />
    <meta name="twitter:image" content={ogImage} />

    {isHome && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Saltar al contenido</a>
    <Header isHome={isHome} />
    <main id="main">
      <slot />
    </main>
    <Footer isHome={isHome} />
    <script>
      import '../scripts/reveal';
    </script>
  </body>
</html>
